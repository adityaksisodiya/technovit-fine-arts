# ============================================================
# TechnoVIT Fine Arts Club — Photo Gallery
# Environment Variables Template
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase Database & Auth (Phase 2) ---
# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Supabase Publishable Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Supabase Secret Key (server-side only, bypasses RLS for admin operations)
SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- Backblaze B2 Storage (Phase 3) ---
# S3-Compatible Endpoint (e.g. https://s3.us-east-005.backblazeb2.com)
B2_ENDPOINT=https://s3.your-region.backblazeb2.com
# B2 Region (e.g. us-east-005)
B2_REGION=your-b2-region
# B2 Bucket Name
B2_BUCKET_NAME=technovit-fine-arts-photos
# B2 Application Key ID (Access Key ID)
B2_KEY_ID=your-b2-key-id
# B2 Application Key (Secret Access Key)
B2_APPLICATION_KEY=your-b2-application-key

# --- Upload Configuration ---
# MAX_UPLOAD_SIZE_BYTES=10485760

# --- Sentry Monitoring (Phase 6) ---
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# --- Resend Email Alerts (Phase 6) ---
# RESEND_API_KEY=
# ALERT_EMAIL_TO=
